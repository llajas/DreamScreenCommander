{
  "pluginAlias": "DreamscreenRM",
  "pluginType": "accessory",
  "singular": false,
  "headerDisplay": "<img src='https://raw.githubusercontent.com/llajas/DreamScreenCommander/master/gfx/DreamscreenRM.svg' width='100%'>\n\nControl your DreamScreen with HomeKit",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "placeholder": "DreamScreen",
        "default": "DreamScreen"
      },
      "ipadress": {
        "title": "IP Address",
        "type": "string",
        "default": "192.168.1.100",
        "placeholder": "192.168.1.100",
        "required": true,
        "format": "ipv4",
        "description": "The IP address of your DreamScreen (can be found in the DreamScreen App under Update and Reset)"
      },
      "group": {
        "title": "Group",
        "type": "string",
        "default": "0",
        "oneOf": [
          { "title": "No Group", "enum": ["0"] },
          { "title": "Group 1", "enum": ["1"] },
          { "title": "Group 2", "enum": ["2"] },
          { "title": "Group 3", "enum": ["3"] }
        ],
        "required": true,
        "description": "Select the DreamScreen group if configured (from top to bottom in app: 1, 2, 3)"
      },
      "model": {
        "title": "Model",
        "type": "string",
        "default": "HD",
        "oneOf": [
          { "title": "DreamScreen 4K", "enum": ["4K"] },
          { "title": "DreamScreen HD", "enum": ["HD"] },
          { "title": "SideKick", "enum": ["SideKick"] }
        ],
        "required": true,
        "description": "Select your DreamScreen model"
      },
      "pollInterval": {
        "title": "Poll Interval (seconds)",
        "type": "integer",
        "default": 10,
        "minimum": 5,
        "maximum": 60,
        "description": "How often to poll the device for state updates"
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "items": [
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": [
            "name",
            "model"
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "items": [
        "ipadress"
      ]
    },
    {
      "type": "fieldset",
      "title": "Advanced Settings",
      "expandable": true,
      "expanded": false,
      "items": [
        "group",
        "pollInterval"
      ]
    }
  ]
}
